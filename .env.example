# Copy to .env. Everything here is read by the API server only (never by the browser;
# do not prefix any of these with VITE_).

# Local Postgres + PostGIS from `docker compose up -d` (local-only credentials).
DATABASE_URL=postgres://ulpin:ulpin_local_dev@127.0.0.1:55432/ulpin

# Password for the three demo accounts created by `npm run db:seed` (min 10 characters).
SEED_DEMO_PASSWORD=

# Session cookies are Secure (HTTPS-only) unless this is false. Keep false only for
# plain-http local development; remove it in any deployment.
COOKIE_SECURE=false

# AI document extraction: set ONE provider (Claude wins if both are set; AI_PROVIDER forces one).
# Leave both empty to run without AI.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b          # reads text extracted from PDFs
GROQ_VISION_MODEL=qwen/qwen3.8-27b      # reads JPG/PNG/WEBP images
# AI_PROVIDER=groq                      # or claude

# Optional
# APP_ORIGINS=http://localhost:5173   # browser origins allowed to make changes (comma-separated)
# TRUST_PROXY=1                        # set when behind a reverse proxy so rate limits see real client IPs
# STORAGE_DIR=server/storage          # where uploaded files are written
# CLAUDE_MODEL=claude-opus-5-5
# PORT=8787